{
  "name": "registro-corrispettivi",
  "productName": "Registro Corrispettivi",
  "version": "1.1.2",
  "description": "Registro dei Corrispettivi",
  "author": "WaxStefanoMusic",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node copy-app.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "it.mobilimagro.registrocorrispettivi",
    "productName": "Registro Corrispettivi",
    "directories": {
      "output": "Installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Registro Corrispettivi",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "it_IT"
      ],
      "language": "1040",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Registro-Corrispettivi-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WaxStefanoMusic",
        "repo": "REGISTRO-CORRISPETTIVI",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "repository": "https://github.com/WaxStefanoMusic/REGISTRO-CORRISPETTIVI",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
